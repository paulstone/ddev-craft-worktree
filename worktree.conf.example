#ddev-generated
# Settings for `ddev worktree` (ddev-craft-worktree add-on).
#
# On install this template is copied to .ddev/worktree.conf only if that file doesn't
# exist yet; edit and commit worktree.conf, never this .example (updates replace it).
# It is sourced by bash, so use bash array syntax. Every path is relative
# to the project root. Uncomment and edit what you need; anything left commented keeps
# the default shown.

# Untracked files copied from the main checkout. Copied .env* files have their
# ://<project>.ddev.site URLs repointed at the worktree's own hostname.
# Default: (.env), plus config/license.key for craftcms projects.
# WORKTREE_COPY_FILES=(.env config/license.key)

# Untracked directories cloned from the main checkout. On macOS (APFS) and reflink-capable
# Linux filesystems this is copy-on-write, so a worktree uses no extra disk for them until
# a file changes. Good for local asset volumes, vendor/, built front-end output.
# Default: none.
# WORKTREE_CLONE_DIRS=(web/assets vendor)

# Directories DDEV should bind-mount instead of syncing through Mutagen (written to the
# worktree's upload_dirs). Use this for large asset folders so they are not duplicated
# into a Docker volume per worktree. Default: none.
# WORKTREE_UPLOAD_DIRS=(web/assets)

# Commands run inside the new worktree after `ddev start`.
# Default: ("ddev composer install") when composer.json exists.
# WORKTREE_POST_START=("ddev composer install" "ddev npm ci" "ddev npm run build")

# Commands run after the database has been imported.
# Default: ("ddev craft up --interactive=0") for craftcms projects, otherwise none.
# WORKTREE_POST_IMPORT=("ddev craft up --interactive=0")

# Keep seed dumps here (for --reuse-db) instead of deleting them after import.
# Never point this at .ddev/db_snapshots. An environment variable of the same name wins.
# WORKTREE_DB_DIR="${WORKTREE_DB_DIR:-$HOME/ddev-worktree-dbs}"
